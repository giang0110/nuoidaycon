# ---------------------------------------------------------------------------
# Supabase — browser-safe values. These are the ONLY Supabase credentials the
# application is allowed to read. Both are safe to expose: the anon key is
# constrained by Row Level Security.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Service-role key — bypasses RLS completely (it carries BYPASSRLS).
#
# Decision A3 (docs/product/PRODUCT_SPEC.md §10, §11.2):
#   * NEVER set this in a Vercel runtime environment.
#   * NEVER read it from app/, lib/ or components/ — ESLint blocks that.
#   * It exists only for local migrations and the seed loader in scripts/.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=""

# Playwright
# PLAYWRIGHT_BASE_URL="http://127.0.0.1:3000"

# ---------------------------------------------------------------------------
# Integration tests — a DISPOSABLE local PostgreSQL, never a hosted project.
#
#   pnpm db:up            start a throwaway cluster and apply the migrations
#   pnpm test:integration run the cross-tenant RLS matrix against it
#   pnpm db:down          delete the cluster
#
# Unset means the database suites skip. They fail loudly instead of skipping
# when CI is set, so a missing database can never look like a pass.
# ---------------------------------------------------------------------------
# TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:55432/nuoidaycon_test"
